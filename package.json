    "view-account": "dotenvx run -- bun index.ts"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "latest",
    "valibot": "1.2.0",
    "viem": "latest"
  },
  "devDependencies": {
    "bun-types": "latest"
  }
}