{
  "name": "poor-richards-wallet",
  "type": "module",
  "private": true,
  "scripts": {
    "overwrite-with-new-key": "umask 077 && touch .env && dotenvx set PK `openssl rand -hex 32` && chmod 600 .env .env.keys",
    "overwrite-with-mixed-key": "bun mix-and-overwrite.ts",
    "harden-with-drand": "bun harden-and-overwrite.ts",
    "harden-with-drand-dry-run": "bun harden-and-overwrite.ts --dry-run",
    "view-account": "dotenvx run -- bun index.ts"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "latest",
    "mersenne-twister": "^1.1.0",
    "valibot": "1.2.0",
    "viem": "latest"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14"
  }
}
